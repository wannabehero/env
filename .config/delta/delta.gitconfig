[core]
    pager = delta
[interactive]
    diffFilter = delta --color-only
[delta]
    features = decorations
    navigate = true
    line-numbers = true
    side-by-side = true
    true-color = always
    hyperlinks = true
[delta "decorations"]
    commit-decoration-style = blue box
    file-decoration-style = blue ul
    hunk-header-decoration-style = blue box
